+# the scan 33 px too high and 22 px too far left at both distances, so beyond ~1 m the LiDAR point
+# fell above the detection box and the observation was dropped.
+# Ideal: [0, -1, 0,  0, 0, -1,  1, 0, 0]
 ROTATION_LIDAR_TO_CAMERA_OPTICAL = [
